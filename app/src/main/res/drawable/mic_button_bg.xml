<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="90dp"
                android:centerX="0.5"
                android:centerY="0.4"
                android:startColor="#1A2540"
                android:endColor="#080C16" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <stroke android:width="1.5dp" android:color="@color/jarvis_accent" />
            <solid android:color="#00000000" />
        </shape>
    </item>
</layer-list>
