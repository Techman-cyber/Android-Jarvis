<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="@color/jarvis_accent_glow" />
            <stroke android:width="1dp" android:color="@color/jarvis_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="@color/jarvis_surface" />
            <stroke android:width="1dp" android:color="@color/jarvis_surface_stroke" />
        </shape>
    </item>
</selector>
